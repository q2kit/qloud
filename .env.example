# =============================================================================
# Docker Compose — hạ tầng cho môi trường DEV
# Tạo `.env` nếu chưa có: [ -f .env ] || cp .env.example .env
# Không dùng `cp -n`: trên macOS lệnh này trả lỗi khi file đã có.
# Cấu hình của Django nằm ở qloud_backend/.env — xem qloud_backend/.env.example
# =============================================================================

COMPOSE_PROJECT_NAME=qloud

# --- PostgreSQL ---
POSTGRES_DB=qloud
POSTGRES_USER=qloud
POSTGRES_PASSWORD=qloud
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- LocalStack (giả lập S3) ---
# Bắt buộc: lấy token tại https://app.localstack.cloud (mục Auth Tokens).
# Thiếu token thì container LocalStack thoát ngay với mã lỗi 55.
LOCALSTACK_AUTH_TOKEN=
LOCALSTACK_PORT=4566
# Bucket được tạo tự động khi LocalStack khởi động
S3_BUCKET=qloud-dev
# Origin của frontend được phép upload/download trực tiếp (CORS của bucket), phân cách bằng dấu phẩy
S3_CORS_ORIGINS=http://localhost:5173

# --- Mailpit (SMTP giả để xem email khi dev) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
