# =============================================================================
# Cấu hình Django / Celery
# Tạo `.env` nếu chưa có: [ -f .env ] || cp .env.example .env
# Không dùng `cp -n`: trên macOS lệnh này trả lỗi khi file đã có.
# Giá trị mặc định dưới đây khớp với docker compose dev (xem ../.env.example).
# =============================================================================

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
# Production: sinh bằng `python -c "import secrets; print(secrets.token_urlsafe(50))"`
# Production bắt buộc thay; settings prod từ chối giá trị mẫu và khóa ngắn hơn 50 ký tự.
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true
LOG_LEVEL=INFO

# --- Domain ---
# Production: domain thật đã trỏ về Cloudflare, ví dụ qloud.example.com
APP_DOMAIN=localhost
# URL gốc mà người dùng truy cập (dùng cho link trong email, CSRF trusted origins)
APP_BASE_URL=http://localhost:5173

# --- Database / Redis ---
DATABASE_URL=postgres://qloud:qloud@localhost:5432/qloud
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# --- Object storage (tương thích S3) ---
# AWS S3: để trống S3_ENDPOINT_URL.
# Cloudflare R2: S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com, S3_REGION=auto
# Dev (LocalStack): như dưới đây — LocalStack chấp nhận access key bất kỳ.
S3_ENDPOINT_URL=http://localhost:4566
S3_REGION=us-east-1
S3_BUCKET=qloud-dev
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
# `path` cho LocalStack; `virtual` cho AWS S3 / R2
S3_ADDRESSING_STYLE=path

# --- Thumbnail worker (quá giới hạn thì dùng icon dự phòng) ---
THUMBNAIL_MAX_SOURCE_BYTES=104857600
THUMBNAIL_MAX_PIXELS=40000000
THUMBNAIL_SOFT_TIME_LIMIT=60
THUMBNAIL_TIME_LIMIT=90
# Worker-only LGPL executables. Build defaults with scripts/build_ffmpeg.py.
# THUMBNAIL_FFMPEG=/absolute/path/to/ffmpeg
# THUMBNAIL_FFPROBE=/absolute/path/to/ffprobe

# --- Email (SMTP) ---
# Dev: Mailpit (xem email tại http://localhost:8025)
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=Qloud <no-reply@localhost>
# Nhận email báo cáo vi phạm
MODERATION_EMAIL=admin@localhost

# --- Đăng ký / OAuth ---
SIGNUP_ENABLED=true
# Để trống CLIENT_ID thì provider bị tắt. Cách tạo app: qloud_docs/features/auth.md › Cấu hình OAuth.
# Callback URL dev: http://localhost:5173/api/auth/oauth/google/login/callback/ (thay google bằng github)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Client IP cho rate limit ---
# Header chứa IP thật do proxy của mình đặt. Dev: để trống (dùng REMOTE_ADDR). Production mặc định CF-Connecting-IP.
TRUSTED_CLIENT_IP_HEADER=

# --- Cloudflare Turnstile ---
# Mặc định là test key của Cloudflare (luôn pass). Production: lấy key thật trong Cloudflare dashboard.
# Frontend lấy site key qua GET /api/v1/config, nên cả hai key chỉ nằm ở đây. Để trống cả hai thì tắt Turnstile.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Theo dõi lỗi ---
SENTRY_DSN=

# Mailbox receiving abuse reports (required in production).
MODERATION_EMAIL=admin@example.com
