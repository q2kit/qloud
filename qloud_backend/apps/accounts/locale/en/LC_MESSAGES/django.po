msgstr "The Qloud team"

msgid "Reset your Qloud password"
msgstr "Reset your Qloud password"

msgid "We received a request to reset the password of your Qloud account. Open this link to choose a new password:"
msgstr "We received a request to reset your Qloud password. Open this link to set a new password:"

msgid "If you did not ask for this, you can ignore this email: your password stays the same."
msgstr "If you didn't request this, ignore this email. Your password will stay the same."

msgid "Password reset request for Qloud"
msgstr "Password reset request for Qloud"

#, python-format
msgid "Someone asked to reset the Qloud password for %(email)s, but there is no Qloud account with this email address."
msgstr "We received a password reset request for %(email)s. This email is not registered with Qloud."

msgid "If it was you, you can create an account here:"
msgstr "If you sent this request, you can create an account here:"

msgid "Otherwise, you can ignore this email."
msgstr "If you didn't send this request, ignore this email."

msgid "You already have a Qloud account"
msgstr "You already have a Qloud account"

#, python-format
msgid "Someone tried to sign up for Qloud with %(email)s, but an account with this email address already exists."
msgstr "We received a sign-up request for %(email)s. This email already has a Qloud account."

msgid "If you forgot your password, you can reset it here:"
msgstr "If you forgot your password, you can reset it here:"

