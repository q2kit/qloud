msgid "No default signup plan is configured."
msgstr "Chưa cấu hình gói mặc định cho đăng ký."

msgid "The selected plan no longer exists."
msgstr "Gói đã chọn không còn tồn tại."

msgid "You cannot suspend your own account."
msgstr "Không thể khóa tài khoản của chính bạn."

msgid "At least one active superuser must remain."
msgstr "Phải còn ít nhất một superuser hoạt động."

msgid "Use this plan for new accounts"
msgstr "Dùng gói này cho tài khoản đăng ký mới"

msgid "Select exactly one active plan."
msgstr "Chọn đúng một gói đang hoạt động."

msgid "Suspend selected accounts"
msgstr "Khóa các tài khoản đã chọn"

msgid "Unsuspend selected accounts"
msgstr "Mở khóa các tài khoản đã chọn"

msgid "The selected plan is inactive."
msgstr "Gói đã chọn ngừng hoạt động."

msgid "The default signup plan must be active."
msgstr "Gói mặc định cho đăng ký phải đang hoạt động."

msgid "Code"
msgstr "Mã gói"

msgid "Name"
msgstr "Tên"

msgid "Storage quota (bytes)"
msgstr "Dung lượng tối đa (byte)"

msgid "Maximum file size (bytes)"
msgstr "Kích thước file tối đa (byte)"

msgid "Maximum old versions per file"
msgstr "Số phiên bản cũ tối đa mỗi file"

msgid "Version retention (days)"
msgstr "Thời gian giữ phiên bản (ngày)"

msgid "Trash retention (days)"
msgstr "Thời gian giữ thùng rác (ngày)"

msgid "Default for signup"
msgstr "Mặc định cho đăng ký"

msgid "Active"
msgstr "Đang hoạt động"

msgid "Plan"
msgstr "Gói dung lượng"

msgid "Plans"
msgstr "Các gói dung lượng"

msgid "Vietnamese"
msgstr "Tiếng Việt"

msgid "English"
msgstr "Tiếng Anh"

msgid "System"
msgstr "Theo hệ thống"

msgid "Light"
msgstr "Sáng"

msgid "Dark"
msgstr "Tối"

msgid "Display name"
msgstr "Tên hiển thị"

msgid "Staff"
msgstr "Nhân viên"

msgid "Avatar URL"
msgstr "URL ảnh đại diện"

msgid "Language"
msgstr "Ngôn ngữ"

msgid "Theme"
msgstr "Giao diện"

msgid "Quota override (bytes)"
msgstr "Dung lượng riêng (byte)"

msgid "Used storage (bytes)"
msgstr "Đã dùng (byte)"

msgid "Reserved storage (bytes)"
msgstr "Đang giữ chỗ (byte)"

msgid "Root folder"
msgstr "Folder gốc"

msgid "Suspended at"
msgstr "Thời điểm khóa"

msgid "Suspension reason"
msgstr "Lý do khóa"

msgid "User"
msgstr "Người dùng"

msgid "Users"
msgstr "Người dùng"

msgid "Accounts"
msgstr "Tài khoản"

msgid "Account state changes require explicit update_fields."
msgstr "Thay đổi trạng thái tài khoản cần chỉ định update_fields rõ ràng."

#, python-format
msgid ""
"%(count)d selected account(s) were already suspended; their original "
"suspension was kept."
msgstr ""
"%(count)d tài khoản đã chọn đang bị khóa từ trước; giữ nguyên thông tin "
"khóa ban đầu."

msgid "Bot verification failed. Please try again."
msgstr "Xác minh chống bot không thành công. Vui lòng thử lại."

msgid "Confirm your email address for Qloud"
msgstr "Xác thực địa chỉ email cho Qloud"

msgid "Hello,"
msgstr "Xin chào,"

msgid "Please confirm the email address of your Qloud account by opening this link:"
msgstr "Vui lòng xác thực địa chỉ email của tài khoản Qloud bằng cách mở liên kết sau:"

msgid "If you did not create a Qloud account, you can ignore this email."
msgstr "Nếu bạn không tạo tài khoản Qloud, bạn có thể bỏ qua email này."

msgid "The Qloud team"
msgstr "Đội ngũ Qloud"

msgid "Reset your Qloud password"
msgstr "Đặt lại mật khẩu Qloud"

msgid "We received a request to reset the password of your Qloud account. Open this link to choose a new password:"
msgstr "Chúng tôi nhận được yêu cầu đặt lại mật khẩu cho tài khoản Qloud của bạn. Mở liên kết sau để chọn mật khẩu mới:"

msgid "If you did not ask for this, you can ignore this email: your password stays the same."
msgstr "Nếu bạn không yêu cầu việc này, bạn có thể bỏ qua email này: mật khẩu của bạn vẫn giữ nguyên."

msgid "Password reset request for Qloud"
msgstr "Yêu cầu đặt lại mật khẩu Qloud"

#, python-format
msgid "Someone asked to reset the Qloud password for %(email)s, but there is no Qloud account with this email address."
msgstr "Có người yêu cầu đặt lại mật khẩu Qloud cho %(email)s, nhưng không có tài khoản Qloud nào dùng địa chỉ email này."

msgid "If it was you, you can create an account here:"
msgstr "Nếu đó là bạn, bạn có thể tạo tài khoản tại đây:"

msgid "Otherwise, you can ignore this email."
msgstr "Nếu không, bạn có thể bỏ qua email này."

msgid "You already have a Qloud account"
msgstr "Bạn đã có tài khoản Qloud"

#, python-format
msgid "Someone tried to sign up for Qloud with %(email)s, but an account with this email address already exists."
msgstr "Có người đã thử đăng ký Qloud bằng %(email)s, nhưng đã có tài khoản dùng địa chỉ email này."

msgid "If you forgot your password, you can reset it here:"
msgstr "Nếu bạn quên mật khẩu, bạn có thể đặt lại tại đây:"

#, python-format
msgid "%(count)d account(s) suspended; their sessions were signed out."
msgstr "Đã khóa %(count)d tài khoản; các phiên đăng nhập của họ đã bị đăng xuất."

#, python-format
msgid "%(count)d account(s) unsuspended."
msgstr "Đã mở khóa %(count)d tài khoản."

msgid "Users and plans"
msgstr "Người dùng và gói dung lượng"
