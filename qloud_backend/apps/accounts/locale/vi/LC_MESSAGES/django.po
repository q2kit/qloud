msgstr ""
"Language: vi\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Plural-Forms: nplurals=1; plural=0;\n"

msgid "No default signup plan is configured."
msgstr "Chưa thiết lập gói mặc định cho tài khoản mới."

msgid "The selected plan no longer exists."
msgstr "Gói đã chọn không còn tồn tại."

msgid "You cannot suspend your own account."
msgstr "Không thể khóa tài khoản của chính bạn."

msgid "At least one active superuser must remain."
msgstr "Phải có ít nhất một quản trị viên cấp cao đang hoạt động."

msgid "Use this plan for new accounts"
msgstr "Đặt làm gói mặc định cho tài khoản mới"

msgid "Select exactly one active plan."
msgstr "Chọn đúng một gói đang hoạt động."

msgid "Suspend selected accounts"
msgstr "Khóa các tài khoản đã chọn"

msgid "Unsuspend selected accounts"
msgstr "Mở khóa các tài khoản đã chọn"

msgid "The selected plan is inactive."
msgstr "Gói đã chọn không còn hoạt động."

msgid "The default signup plan must be active."
msgstr "Gói mặc định cho tài khoản mới phải đang hoạt động."

msgid "Code"
msgstr "Mã gói"

msgid "Name"
msgstr "Tên"

msgid "Storage quota (bytes)"
msgstr "Dung lượng tối đa (byte)"

msgid "Maximum file size (bytes)"
msgstr "Dung lượng tệp tối đa (byte)"

msgid "Maximum old versions per file"
msgstr "Số phiên bản cũ tối đa của mỗi tệp"

msgid "Version retention (days)"
msgstr "Thời gian lưu phiên bản cũ (ngày)"

msgid "Trash retention (days)"
msgstr "Thời gian lưu các mục trong thùng rác (ngày)"

msgid "Default for signup"
msgstr "Mặc định cho tài khoản mới"

msgid "Active"
msgstr "Đang hoạt động"

msgid "Plan"
msgstr "Gói dung lượng"

msgid "Plans"
msgstr "Các gói dung lượng"

msgid "Vietnamese"
msgstr "Tiếng Việt"

msgid "English"
msgstr "Tiếng Anh"

msgid "System"
msgstr "Theo hệ thống"

msgid "Light"
msgstr "Sáng"

msgid "Dark"
msgstr "Tối"

msgid "Display name"
msgstr "Tên hiển thị"

msgid "Staff"
msgstr "Có quyền truy cập trang quản trị"

msgid "Avatar URL"
msgstr "Đường dẫn ảnh đại diện"

msgid "Language"
msgstr "Ngôn ngữ"

msgid "Theme"
msgstr "Giao diện"

msgid "Quota override (bytes)"
msgstr "Giới hạn dung lượng riêng (byte)"

msgid "Used storage (bytes)"
msgstr "Dung lượng đã dùng (byte)"

msgid "Reserved storage (bytes)"
msgstr "Dung lượng đang giữ chỗ (byte)"

msgid "Root folder"
msgstr "Thư mục gốc"

msgid "Suspended at"
msgstr "Thời điểm khóa"

msgid "Suspension reason"
msgstr "Lý do khóa"

msgid "User"
msgstr "Người dùng"

msgid "Users"
msgstr "Người dùng"

msgid "Accounts"
msgstr "Tài khoản"

msgid "Account state changes require explicit update_fields."
msgstr "Không thể cập nhật trạng thái tài khoản bằng thao tác này."

#, python-format
msgid ""
"%(count)d selected account(s) were already suspended; their original "
"suspension was kept."
msgstr "%(count)d tài khoản đã bị khóa từ trước. Thông tin khóa ban đầu được giữ nguyên."

msgid "Bot verification failed. Please try again."
msgstr "Không thể hoàn tất xác minh. Vui lòng thử lại."

msgid "Confirm your email address for Qloud"
msgstr "Xác thực email của bạn trên Qloud"

msgid "Hello,"
msgstr "Xin chào,"

msgid "Please confirm the email address of your Qloud account by opening this link:"
msgstr "Mở liên kết sau để xác thực email của bạn trên Qloud:"

msgid "If you did not create a Qloud account, you can ignore this email."
msgstr "Nếu bạn không tạo tài khoản Qloud, bạn có thể bỏ qua email này."

msgid "The Qloud team"
msgstr "Đội ngũ Qloud"

msgid "Reset your Qloud password"
msgstr "Đặt lại mật khẩu Qloud"

msgid "We received a request to reset the password of your Qloud account. Open this link to choose a new password:"
msgstr "Chúng tôi nhận được yêu cầu đặt lại mật khẩu Qloud của bạn. Mở liên kết sau để đặt mật khẩu mới:"

msgid "If you did not ask for this, you can ignore this email: your password stays the same."
msgstr "Nếu bạn không gửi yêu cầu này, hãy bỏ qua email. Mật khẩu của bạn sẽ không thay đổi."

msgid "Password reset request for Qloud"
msgstr "Yêu cầu đặt lại mật khẩu Qloud"

#, python-format
msgid "Someone asked to reset the Qloud password for %(email)s, but there is no Qloud account with this email address."
msgstr "Chúng tôi nhận được yêu cầu đặt lại mật khẩu cho %(email)s. Tuy nhiên, email này chưa được đăng ký trên Qloud."

msgid "If it was you, you can create an account here:"
msgstr "Nếu bạn đã gửi yêu cầu này, bạn có thể tạo tài khoản tại đây:"

msgid "Otherwise, you can ignore this email."
msgstr "Nếu bạn không gửi yêu cầu này, hãy bỏ qua email."

msgid "You already have a Qloud account"
msgstr "Bạn đã có tài khoản Qloud"

#, python-format
msgid "Someone tried to sign up for Qloud with %(email)s, but an account with this email address already exists."
msgstr "Chúng tôi nhận được yêu cầu đăng ký Qloud bằng %(email)s. Email này đã có tài khoản."

msgid "If you forgot your password, you can reset it here:"
msgstr "Nếu quên mật khẩu, bạn có thể đặt lại tại đây:"

#, python-format
msgid "%(count)d account(s) suspended; their sessions were signed out."
msgstr "Đã khóa %(count)d tài khoản và đăng xuất các tài khoản này trên mọi trình duyệt."

#, python-format
msgid "%(count)d account(s) unsuspended."
msgstr "Đã mở khóa %(count)d tài khoản."

msgid "Users and plans"
msgstr "Người dùng và gói dung lượng"

# allauth ships no Vietnamese catalog, and Django 6.1 changed some password
# messages its own catalog has not caught up with; these are served from here.

msgid "This account is currently inactive."
msgstr "Tài khoản này hiện không hoạt động."

msgid "You cannot remove your primary email address."
msgstr "Không thể xóa địa chỉ email chính."

msgid "This email address is already associated with this account."
msgstr "Email này đã được thêm vào tài khoản."

msgid "The email address and/or password you specified are not correct."
msgstr "Email hoặc mật khẩu không đúng."

msgid "The phone number and/or password you specified are not correct."
msgstr "Số điện thoại hoặc mật khẩu không đúng."

msgid "A user is already registered with this email address."
msgstr "Email này đã được đăng ký."

msgid "Please type your current password."
msgstr "Vui lòng nhập mật khẩu hiện tại."

msgid "Incorrect code."
msgstr "Mã không đúng."

msgid "Incorrect password."
msgstr "Mật khẩu không đúng."

msgid "Invalid or expired key."
msgstr "Liên kết không hợp lệ hoặc đã hết hạn."

msgid "Invalid login."
msgstr "Đăng nhập không hợp lệ."

msgid "The password reset token was invalid."
msgstr "Liên kết đặt lại mật khẩu không hợp lệ."

msgid "A user is already registered with this phone number."
msgstr "Số điện thoại này đã được đăng ký."

msgid "Too many failed login attempts. Try again later."
msgstr "Bạn đã đăng nhập sai quá nhiều lần. Vui lòng thử lại sau."

msgid "The email address is not assigned to any user account."
msgstr "Không có tài khoản nào dùng email này."

msgid "The phone number is not assigned to any user account."
msgstr "Không có tài khoản nào dùng số điện thoại này."

msgid "Your primary email address must be verified."
msgstr "Hãy xác thực địa chỉ email chính của bạn."

msgid "Username can not be used. Please use other username."
msgstr "Không thể dùng tên đăng nhập này. Hãy chọn tên khác."

msgid "The username and/or password you specified are not correct."
msgstr "Tên đăng nhập hoặc mật khẩu không đúng."

msgid "A user with that username already exists."
msgstr "Tên đăng nhập này đã được sử dụng."

msgid "Please select only one."
msgstr "Vui lòng chỉ chọn một."

msgid "The new value must be different from the current one."
msgstr "Giá trị mới phải khác giá trị hiện tại."

msgid "Be patient, you are sending too many requests."
msgstr "Bạn đã gửi quá nhiều yêu cầu. Vui lòng đợi một chút rồi thử lại."

msgid "Invalid token."
msgstr "Thông tin xác thực không hợp lệ."

msgid "Your account has no password set up."
msgstr "Tài khoản của bạn chưa có mật khẩu. Hãy đặt mật khẩu trước khi gỡ liên kết tài khoản."

msgid "Your account has no verified email address."
msgstr "Bạn chưa xác thực địa chỉ email nào cho tài khoản này."

msgid "You cannot disconnect your last remaining third-party account."
msgstr "Không thể gỡ tài khoản liên kết cuối cùng."

msgid "The third-party account is already connected to a different account."
msgstr "Tài khoản này đã được liên kết với một người dùng khác."

msgid "You must type the same password each time."
msgstr "Hai mật khẩu bạn nhập không khớp."

msgid "You must type the same email each time."
msgstr "Hai địa chỉ email bạn nhập không khớp."

#, python-format
msgid "An account already exists with this email address. Please sign in to that account first, then connect your %s account."
msgstr "Email này đã có tài khoản Qloud. Hãy đăng nhập vào tài khoản đó rồi liên kết tài khoản %s."

#, python-format
msgid "You cannot add more than %d email addresses."
msgstr "Không thể thêm quá %d địa chỉ email."

#, python-format
msgid "This password is too short. It must contain at least %d character."
msgid_plural "This password is too short. It must contain at least %d characters."
msgstr[0] "Mật khẩu phải có ít nhất %d ký tự."

