msgstr "Xem báo cáo"

msgid "A public link was removed on Qloud"
msgstr "Một liên kết công khai đã bị thu hồi trên Qloud"

msgid "A public link to your item was removed by moderation."
msgstr "Quản trị viên đã thu hồi một liên kết công khai tới tệp hoặc thư mục của bạn."

msgid "Note:"
msgstr "Ghi chú:"

msgid "The removed link cannot be reactivated."
msgstr "Liên kết đã thu hồi không thể khôi phục."
