# =============================================================================
# Production .env cho infra/production/compose.yml (qloud_docs/deploy.md)
# Tạo trên server: [ -f .env ] || cp .env.example .env   (rồi điền mọi chỗ <...>)
# Một file cho cả compose (${...}) lẫn Django/Celery (env_file). Không commit file .env.
# Sinh chuỗi ngẫu nhiên: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# =============================================================================

# --- Image (GHCR) ---
# Tag: `master` (bản mới nhất trên master) hoặc `sha-<7 ký tự commit>` để ghim một bản.
QLOUD_IMAGE_PREFIX=ghcr.io/q2kit/qloud
QLOUD_TAG=master
# Cổng HTTP trên 127.0.0.1 mà nginx của host proxy tới (deploy.md › nginx của host).
QLOUD_HTTP_PORT=8080

# --- Tài nguyên ---
GUNICORN_WORKERS=3
GUNICORN_THREADS=4
CELERY_CONCURRENCY=2

# --- Django ---
# Bắt buộc: settings prod từ chối giá trị mẫu và khóa ngắn hơn 50 ký tự.
DJANGO_SECRET_KEY=<secrets.token_urlsafe(50)>
LOG_LEVEL=INFO
# Domain thật đã trỏ về Cloudflare (proxy bật), ví dụ qloud.example.com
APP_DOMAIN=<qloud.example.com>
# HSTS 1 năm; đặt 0 trong lúc thử domain mới.
DJANGO_HSTS_SECONDS=31536000

# --- PostgreSQL ---
# Mật khẩu dùng ký tự an toàn trong URL (token_urlsafe), vì nó được ghép vào DATABASE_URL.
POSTGRES_DB=qloud
POSTGRES_USER=qloud
POSTGRES_PASSWORD=<secrets.token_urlsafe(32)>

# --- Object storage (tương thích S3) ---
# AWS S3: để trống S3_ENDPOINT_URL. Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com, S3_REGION=auto
S3_ENDPOINT_URL=
S3_REGION=<us-east-1>
S3_BUCKET=<qloud-prod>
S3_ACCESS_KEY_ID=<access-key>
S3_SECRET_ACCESS_KEY=<secret-key>
S3_ADDRESSING_STYLE=virtual

# --- Email (SMTP) ---
EMAIL_HOST=<smtp.example.com>
EMAIL_PORT=587
EMAIL_HOST_USER=<user>
EMAIL_HOST_PASSWORD=<password>
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Qloud <no-reply@qloud.example.com>
# Nhận email báo cáo vi phạm (bắt buộc)
MODERATION_EMAIL=<abuse@qloud.example.com>

# --- Đăng ký / OAuth ---
# Callback: https://<APP_DOMAIN>/api/auth/oauth/google/login/callback/ (thay google bằng github)
SIGNUP_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Cloudflare Turnstile (bắt buộc, key thật) ---
TURNSTILE_SITE_KEY=<site-key>
TURNSTILE_SECRET_KEY=<secret-key>

# --- Thumbnail worker ---
THUMBNAIL_MAX_SOURCE_BYTES=104857600
THUMBNAIL_MAX_PIXELS=40000000
THUMBNAIL_SOFT_TIME_LIMIT=60
THUMBNAIL_TIME_LIMIT=90
