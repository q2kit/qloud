# Build context for infra/docker/Dockerfile: only what the images need, never secrets.
*
!infra/nginx/
!scripts/build_ffmpeg.py
!qloud_backend/
!qloud_frontend/

**/.env
**/.env.*
**/*.pem
**/*.key
**/*.crt
**/.DS_Store
**/__pycache__/
**/node_modules/

qloud_backend/.venv/
qloud_backend/.mypy_cache/
qloud_backend/.ruff_cache/
qloud_backend/.pytest_cache/
qloud_backend/.coverage*
qloud_backend/htmlcov/
qloud_backend/staticfiles/

qloud_frontend/dist/
qloud_frontend/coverage/
qloud_frontend/public/pdfjs/
qloud_frontend/playwright-report*/
qloud_frontend/test-results*/
qloud_frontend/*.tsbuildinfo
